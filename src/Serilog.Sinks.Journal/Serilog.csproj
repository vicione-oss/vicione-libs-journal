  <PropertyGroup>
    <AssemblyName>Serilog.Sinks.Journal</AssemblyName>
    <RootNamespace>Serilog.Sinks.Journal</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ViciOne.Journal.Logging\IOVector.cs" Link="IOVector.cs" />
    <Compile Include="..\ViciOne.Journal.Logging\JournalEntryFactory.cs" Link="JournalEntryFactory.cs" />
    <Compile Include="..\ViciOne.Journal.Logging\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\ViciOne.Journal.Logging\SystemdJournalWriter.cs" Link="SystemdJournalWriter.cs" />
    <Compile Include="..\ViciOne.Journal\JournalOpeningMode.cs" Link="JournalOpeningMode.cs" />
    <Compile Include="..\ViciOne.Journal\SafeJournalHandle.cs" Link="SafeJournalHandle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
